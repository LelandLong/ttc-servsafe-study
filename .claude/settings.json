{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/crossfeed/set-status.sh CHEF WORKING \"(turn in progress)\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/crossfeed/check-unread.sh CHEF"
          }
        ]
      }
    ]
  }
}

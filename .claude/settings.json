{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "G=\"$HOME/crossfeed/crossfeed-guard-log.mjs\"; [ -f \"$G\" ] || exit 0; exec node \"$G\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/crossfeed/set-status.sh CHEF WORKING \"(turn in progress)\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/crossfeed/check-unread.sh CHEF"
          }
        ]
      }
    ]
  }
}
